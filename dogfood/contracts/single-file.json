{
  "version": 1,
  "checks": [
    {
      "id": "protected-diff",
      "kind": "diff",
      "deny": [
        ".github/**",
        ".github/workflows/**",
        "SECURITY.md",
        "scripts/**",
        "scripts/test-layers.sh",
        "scripts/ssh-env.sh",
        "scripts/coverage.sh",
        "docker/**",
        "docker/Dockerfile.ssh",
        "docs/adr/**",
        "examples/fleet.example.toml",
        "examples/agents/**",
        "examples/neo/**",
        "examples/fanout-contract.json",
        "examples/github/**",
        "dogfood/**",
        "lefthook.yml",
        ".secret-scan-allow",
        ".gitignore",
        ".gitattributes",
        ".gitmodules",
        ".cargo/**",
        ".omp/**",
        ".mcp.json",
        "AGENTS.md",
        "rust-toolchain.toml",
        "rustfmt.toml",
        ".rustfmt.toml",
        "clippy.toml",
        ".clippy.toml",
        "Cargo.toml",
        "Cargo.lock",
        "crates/*/Cargo.toml",
        "crates/*/build.rs",
        "crates/fleet-domain/src/approval.rs",
        "crates/fleet-domain/src/decision.rs",
        "crates/fleet-domain/src/fleet.rs",
        "crates/fleet-domain/src/run.rs",
        "crates/fleet-domain/src/supervision.rs",
        "crates/fleet-domain/src/env.rs",
        "crates/fleet-domain/src/ids.rs",
        "crates/fleet-domain/src/limits.rs",
        "crates/fleet-domain/src/brief.rs",
        "crates/fleet-domain/src/contract.rs",
        "crates/fleet-domain/src/remote.rs",
        "crates/fleet-domain/src/msg/**",
        "crates/fleet-domain/src/repo/**",
        "crates/fleet-forge/**",
        "crates/fleet-fanout/**",
        "crates/fleet-domain/src/events.rs",
        "crates/fleet-domain/src/chain.rs",
        "crates/fleet-domain/src/value.rs",
        "crates/fleet-domain/src/quality.rs",
        "crates/fleet-domain/src/redact.rs",
        "crates/fleet-domain/src/sanitize.rs",
        "crates/fleet-domain/src/output.rs",
        "crates/fleet-domain/src/lib.rs",
        "crates/neo-verify/**",
        "crates/neo-goals/**",
        "crates/neo-context/**",
        "crates/neo-context/src/secret.rs",
        "crates/neo-context/src/pack.rs",
        "crates/fleet-app/src/neo/context*.rs",
        "crates/fleet-infra/src/context_store.rs",
        "crates/fleet-app/**",
        "crates/fleet-app/src/remote.rs",
        "crates/fleet-app/src/fanout/pick.rs",
        "crates/fleet-app/src/forge/**",
        "crates/fleet-app/src/orchestrator/messaging.rs",
        "crates/fleet-infra/**",
        "crates/fleet-infra/src/ssh/**",
        "crates/fleet-infra/src/ssh/known_hosts.rs",
        "crates/fleet-infra/src/ssh/trust.rs",
        "crates/fleet-infra/src/hosts_file.rs",
        "crates/fleet-infra/src/git/push.rs",
        "crates/fleet-infra/src/git/remote_sync.rs",
        "crates/fleet-infra/src/forge_gh.rs",
        "crates/fleet-infra/src/msgfs.rs",
        "crates/fleet-infra/src/web/**",
        "crates/fleet-infra/web/**",
        "crates/fleet-infra/tests/ssh_remote.rs",
        "crates/fleet-infra/tests/dogfood.rs",
        "crates/fleet-cli/**",
        "crates/fleet-cli/tests/e2e_remote.rs",
        "crates/fleet-cli/tests/architecture.rs"
      ]
    },
    {
      "id": "protected-script",
      "kind": "command",
      "program": "@TOOLS@/check-protected.sh",
      "args": ["--repo", "@REPO@", "@BASE@..fleet/@RUN@/@TASK@"],
      "timeout_ms": 60000
    },
    {
      "id": "lock-unchanged",
      "kind": "file",
      "path": "Cargo.lock",
      "assert": "sha256",
      "value": "@LOCK_SHA256@"
    },
    {
      "id": "docs-claims",
      "kind": "command",
      "program": "@TOOLS@/check-docs-claims.sh",
      "args": ["--repo", "@REPO@", "@BASE@..fleet/@RUN@/@TASK@"],
      "timeout_ms": 60000
    },
    {
      "id": "conflict-markers",
      "kind": "command",
      "program": "@TOOLS@/check-conflict-markers.sh",
      "args": ["--tree"],
      "timeout_ms": 60000
    },
    {
      "id": "secret-scan",
      "kind": "command",
      "program": "@TOOLS@/check-secret-tree.sh",
      "timeout_ms": 120000
    },
    {
      "id": "fmt",
      "kind": "command",
      "program": "@CONTAINER_RUN@",
      "args": ["cargo fmt --all -- --check"],
      "timeout_ms": 300000
    },
    {
      "id": "clippy",
      "kind": "command",
      "program": "@CONTAINER_RUN@",
      "args": ["cargo clippy --workspace --all-targets --locked --offline -- -D warnings"],
      "timeout_ms": 1200000
    },
    {
      "id": "architecture",
      "kind": "command",
      "program": "@CONTAINER_RUN@",
      "args": ["cargo test --locked --offline -p fleet-cli --test architecture"],
      "timeout_ms": 1200000
    },
    {
      "id": "layers",
      "kind": "command",
      "program": "@CONTAINER_RUN@",
      "args": ["sh scripts/test-layers.sh"],
      "timeout_ms": 1800000
    }
,
    {
      "id": "scope",
      "kind": "diff",
      "allow": ["@FILE_PATH@"@ALSO@]
    }
  ]
}
