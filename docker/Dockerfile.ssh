# Development image plus an OpenSSH client and server, for the SSH remote worktree tests and demo.
# The tests start their own sshd as an ordinary user on a high port with keys generated at run time
# (nothing is committed); the image only provides the binaries. /etc/passwd is made writable for the
# test run only, so that scripts/ssh-env.sh can add the entry that sshd and ssh need for an arbitrary
# uid. Never use this image for anything but tests.
#   docker build -f docker/Dockerfile.dev -t fleet-dev docker/
#   docker build -f docker/Dockerfile.ssh -t fleet-ssh docker/
FROM fleet-dev
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client openssh-server \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd && chmod 666 /etc/passwd
